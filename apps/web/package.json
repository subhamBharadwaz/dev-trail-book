    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "@trailbook/content": "workspace:*",
    "@trailbook/learning": "workspace:*",
    "@trailbook/sync": "workspace:*",
    "@ui-sdk/core": "^0.1.0-beta.1",
