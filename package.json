{
  "name": "dev-trailbook",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@trailbook/web",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "android": "bun run --cwd apps/mobile android",
    "build": "turbo run build --filter=@trailbook/web && bun scripts/cloudflare-output.ts",
    "build:android": "bun run --cwd apps/mobile export:android",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "bun run content && bun run typecheck && bun run lint && bun run test && bun run build",
    "content": "bun run --cwd packages/content generate",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,json}\" \"scripts/*.ts\" package.json turbo.json README.md docs/mobile-app.md",
    "preview": "bun run --cwd apps/web preview"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
